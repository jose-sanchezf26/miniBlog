---
const { post } = Astro.props;
---
<article class="bg-white p-5 shadow-lg rounded-lg border border-gray-200 hover:shadow-xl transition duration-300">
	<h3 class="text-xl font-bold mb-2 text-gray-800">{post.title}</h3>
    <div class="flex justify-between items-center text-sm text-gray-500 mb-3">
        <p class="font-semibold text-indigo-600">Categoría: {post.category}</p>
        <small>{new Date(post.createdAt).toLocaleDateString('es-ES')}</small>
    </div>
	<p class="text-gray-700 mb-4">{post.content}</p>
    <footer>
        <span class="text-sm text-gray-600">
            Autor: <a href={`/users/${post.author}`} class="text-blue-500 hover:underline font-medium">{post.author}</a>
        </span>
    </footer>
</article>